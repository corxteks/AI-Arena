# Salin menjadi .env lalu isi. JANGAN commit .env.
PORT=3000
# Alamat situs frontend yang diizinkan memanggil API (pisahkan koma)
CORS_ORIGINS=http://localhost:8080,https://corxteks.github.io
# 1 = izinkan localhost dan IP jaringan lokal (untuk uji dari HP di Wi-Fi yang sama). Matikan di produksi.
CORS_ALLOW_LAN=1

# Database (sesuai docker-compose.yml). Nilai di bawah hanya untuk pengembangan lokal.
POSTGRES_USER=arena
POSTGRES_PASSWORD=arena_dev_password
POSTGRES_DB=arena
POSTGRES_PORT=5433
DATABASE_URL=postgres://arena:arena_dev_password@localhost:5433/arena

# Rahasia penanda sesi. Buat acak panjang: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti-dengan-rahasia-acak-panjang-minimal-32-karakter
JWT_EXPIRES_IN=30d
# Batas percobaan masuk/daftar per IP per 15 menit
AUTH_RATE_LIMIT=30
# Kunci 32 byte (64 hex) untuk mengenkripsi token YouTube di database
TOKEN_ENC_KEY=

# YouTube Live (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, tipe Web application)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/youtube/oauth/callback
# Kuota harian YouTube Data API (default Google: 10000 unit)
YOUTUBE_DAILY_QUOTA=10000
